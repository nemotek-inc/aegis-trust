{
  "name": "aegis-trust",
  "version": "0.10.2",
  "description": "AI agent data access control — control what agents can see. TypeScript port of aegis-trust PyPI (literal name parity).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aegis": "./dist/cli.js",
    "aegis-mcp-proxy": "./dist/mcpProxy.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./doctor": {
      "types": "./dist/doctor/index.d.ts",
      "import": "./dist/doctor/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "e2e:mcp": "node tests/mcp/run_end_to_end.mjs && node tests/mcp/run_dev_agent_workflow.mjs",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "parity": "node ../scripts/version-parity.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "security",
    "privacy",
    "trust",
    "scope",
    "purpose",
    "mcp",
    "data-access",
    "field-level",
    "decorator",
    "minimum-disclosure"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vitest": "^5.0.0",
    "yaml": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nemotek-inc/aegis-trust.git",
    "directory": "node"
  },
  "homepage": "https://github.com/nemotek-inc/aegis-trust#readme",
  "bugs": {
    "url": "https://github.com/nemotek-inc/aegis-trust/issues"
  },
  "author": "Incierge <contact@aegisagentcontrol.com>"
}
