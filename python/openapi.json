{
  "openapi": "3.1.0",
  "info": {
    "title": "aegis-trust FULL-mode backend contract (SDK-called subset)",
    "description": "Minimal reference contract listing ONLY the backend endpoints the aegis-trust SDK calls in FULL mode. It exists in this repo solely so the SDK contract test can verify the client targets declared endpoints. The open-source SDK runs in LITE mode (local field reduction, no backend) by default; the backend service and its full API are NOT part of this package. Request/response schemas are intentionally omitted \u2014 this stub documents the SDK's integration surface only, not the backend's complete API.",
    "contact": {
      "name": "aegis-trust maintainers",
      "url": "https://github.com/nemotek-inc/aegis-trust"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/nemotek-inc/aegis-trust/blob/main/LICENSE"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1 base path"
    }
  ],
  "paths": {
    "/check-access": {
      "post": {
        "summary": "FULL-mode authorization check before data release",
        "responses": {
          "200": {
            "description": "Authorization decision"
          }
        }
      }
    },
    "/check-boundary": {
      "post": {
        "summary": "FULL-mode Doctor v1 boundary check (Core-backed BoundaryDecisionView)",
        "responses": {
          "200": {
            "description": "BoundaryDecisionView (source=CORE)"
          }
        }
      }
    },
    "/shield/ingest": {
      "post": {
        "summary": "Post-authorization audit ingest",
        "responses": {
          "200": {
            "description": "Audit record accepted"
          }
        }
      }
    },
    "/shield/policy-sync": {
      "post": {
        "summary": "Policy synchronization",
        "responses": {
          "200": {
            "description": "Policy synced"
          }
        }
      }
    },
    "/shield/stats": {
      "get": {
        "summary": "Shield statistics",
        "responses": {
          "200": {
            "description": "Statistics"
          }
        }
      }
    },
    "/shield/report": {
      "get": {
        "summary": "Shield report",
        "responses": {
          "200": {
            "description": "Report"
          }
        }
      }
    },
    "/audit/verify": {
      "get": {
        "summary": "Verify audit chain / inclusion",
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditVerifyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/audit-log": {
      "post": {
        "summary": "Append an audit log entry (FULL-mode log_audit)",
        "responses": {
          "200": {
            "description": "Audit entry accepted"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Backend health probe",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/tool-call": {
      "post": {
        "summary": "AI-native v1: decide one tool invocation at the boundary",
        "responses": {
          "200": {
            "description": "{decision, enforcement} — BLOCKED is still 200; gate on decision.outcome + decision.ledgered"
          }
        }
      }
    },
    "/capability/mint": {
      "post": {
        "summary": "AI-native v1: mint a delegation capability (narrow-only lineage)",
        "responses": {
          "200": {
            "description": "{capability, id, exp, depth, root_delegator}"
          }
        }
      }
    },
    "/capability/revoke": {
      "post": {
        "summary": "AI-native v1: revoke a capability (transitive; cuts matching streams)",
        "responses": {
          "200": {
            "description": "{ok, revoked}"
          }
        }
      }
    },
    "/stream/open": {
      "post": {
        "summary": "AI-native v1: open a continuous-authz stream from a Common Envelope decision",
        "responses": {
          "200": {
            "description": "{decision, enforcement, stream|null}"
          }
        }
      }
    },
    "/stream/heartbeat": {
      "post": {
        "summary": "AI-native v1: revalidate a stream against the live registries",
        "responses": {
          "200": {
            "description": "{status: ok|revoked|closed, reason?}"
          }
        }
      }
    },
    "/stream/close": {
      "post": {
        "summary": "AI-native v1: close a stream (owner or Admin; chain-witnessed)",
        "responses": {
          "200": {
            "description": "{ok}"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditVerifyResponse": {
        "type": "object",
        "required": [
          "chain_valid",
          "total_entries"
        ],
        "properties": {
          "chain_valid": {
            "type": "boolean",
            "description": "Chain integrity status"
          },
          "total_entries": {
            "type": "integer",
            "format": "int64",
            "description": "Total entries verified",
            "minimum": 0
          }
        }
      }
    }
  }
}
